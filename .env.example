# Which AI powers Claudia:
#   anthropic — Claude (default, needs ANTHROPIC_API_KEY, includes live web search)
#   gemini    — Google Gemini free tier (needs GEMINI_API_KEY; no live web search)
#   demo      — no API at all, plays back a pre-written run (great for rehearsing / offline backup)
LLM_PROVIDER=demo

# Claude: get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5-5
WEB_SEARCH_TOOL=web_search_20250305

# Email tracker storage (needed on Vercel; locally it falls back to .data/db.json)
# Create a free Upstash Redis database (or add Vercel KV from the Vercel dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: force the base URL used in tracked links (defaults to the request host)
PUBLIC_URL=
